# 부자알람 봇 — 환경변수 (로컬은 .env, 배포는 GitHub Secrets)
# 실제 값은 .env 에 넣고 절대 커밋하지 말 것 (.gitignore 등록됨)

# 텔레그램 — BotFather로 새로 만든 봇 토큰
TELEGRAM_TOKEN=

# Gemini API (기존 키 재사용 가능)
GEMINI_KEY=

# Supabase — 프로젝트 Settings → API
SUPABASE_URL=
SUPABASE_KEY=            # service_role 키 (서버용, 비밀)

# 자막 프록시 (레지던셜, 데이터센터 IP 자막차단 우회) — Webshare 등
YT_PROXY=               # http://user:pass@host:port

# YouTube Data API (B2 온보딩·유튜버 검색용, 나중에)
YOUTUBE_API_KEY=
